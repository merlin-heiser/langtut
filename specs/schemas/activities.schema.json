{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://langtut.local/schemas/activities.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["activities"],
  "properties": {
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "roles", "turnOrder", "rounds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "type": { "enum": ["roleplay", "flashcards_translation", "gap_fill", "sentence_building", "declension_drills", "conjugation_drills", "dictation_light"] },
          "exercise": { "type": "object", "additionalProperties": false, "required": ["prompt", "answers"], "properties": { "prompt": { "type": "string", "minLength": 1 }, "answers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "tokens": { "type": "array", "items": { "type": "string" } }, "hint": { "type": "string" } } },
          "scenarioTarget": { "type": "string", "minLength": 1 },
          "scenarioSource": { "type": "string", "minLength": 1 },
          "roles": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "controller"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "controller": { "enum": ["learner", "llm", "fixed"] },
                "prompt": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          },
          "turnOrder": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "rounds": { "type": "integer", "minimum": 1, "maximum": 100 },
          "focusTags": { "type": "array", "items": { "type": "string" } },
          "moduleIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
