{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://langtut.local/schemas/learning-package.schema.json",
  "title": "Langtut learning package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "targetLanguage", "sourceLanguage", "targetLevel"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "targetLanguage": { "$ref": "#/$defs/language" },
    "sourceLanguage": { "$ref": "#/$defs/language" },
    "targetLevel": { "type": "string", "minLength": 1 },
    "ankiDeck": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name"],
      "properties": {
        "code": { "type": "string", "minLength": 2 },
        "name": { "type": "string", "minLength": 1 }
      }
    }
  }
}
